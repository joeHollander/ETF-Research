\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scatter plot of one-day returns for spot gold versus 1-month gold futures. The regression slope of 0.9996 demonstrates a near one-to-one relationship.}}{2}{}\protected@file@percent }
\newlabel{fig:spot_vs_1m_returns}{{1}{2}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparison of closing prices for spot gold, 1-month futures, and 12-month futures in early 2024. The 1-month contract tracks the spot price closely, while the 12-month contract maintains a significant premium (contango).}}{2}{}\protected@file@percent }
\newlabel{fig:price_series}{{2}{2}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Regression slope of futures vs. spot returns, analyzed by contract maturity and the return window length in days. For most maturities, the slope approaches 1 as the return window lengthens.}}{3}{}\protected@file@percent }
\newlabel{fig:slope_by_maturity}{{3}{3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Visual comparison of tracking performance in early 2024. The top panel shows replication of spot gold using futures portfolios, while the bottom panel shows the GLD ETF's tracking of spot gold. The futures portfolios achieve a lower RMSE in this period than GLD.}}{5}{}\protected@file@percent }
\newlabel{fig:replication_vs_gld}{{4}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Out-of-sample RMSE for various futures portfolios across different cross-validation training periods. The pink bars represent the spot price volatility during each out-of-sample period. Tracking error tends to be higher in periods of higher market volatility, such as 2020 and post-2022.}}{6}{}\protected@file@percent }
\newlabel{fig:rmse_and_vol}{{5}{6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Performance of spot gold versus a 2x leveraged benchmark from 2020 to 2023, with both series indexed to 100. This illustrates the compounding effect (volatility drag) over long periods, where the leveraged product's return is not simply double the spot return.}}{8}{}\protected@file@percent }
\newlabel{fig:rebased_leverage}{{6}{8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Out-of-sample RMSE for various futures portfolios attempting to replicate a 2x leveraged benchmark across different cross-validation folds. The tracking error is consistently high across all time periods, though it varies with market conditions.}}{9}{}\protected@file@percent }
\newlabel{fig:rmse_leverage}{{7}{9}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1}Dynamic Replication}{9}{}\protected@file@percent }
